

CREATE TABLE TBL_MST_USERDETAILS (
    USERID    NUMBER GENERATED ALWAYS AS IDENTITY,
    USERNAME  VARCHAR2(15 CHAR),
    PASS_WORD  VARCHAR2(250 CHAR),
    GROUPID  NUMBER(3, 0),
    FIRSTNAME VARCHAR2(60 CHAR),
    LASTNAME  VARCHAR2(25 CHAR),
    FULLNAME  VARCHAR2(60 CHAR),
    EMAIL  VARCHAR2(60 CHAR),
    MOBILE  VARCHAR2(15 CHAR),
    ADDRESS  VARCHAR2(100 CHAR),
    CREATED_ON  DATE,
    STATUSFLAG  NUMBER(1, 0),
    CONSTRAINT PK_HOMEDETAILS_HOUSE_ID PRIMARY KEY ( HOUSE_ID )
);

/

CREATE TABLE TBL_MST_HM_HOMEDETAILS (
    HOUSE_ID    NUMBER GENERATED ALWAYS AS IDENTITY,
    OWNER_ID    NUMBER(10, 0),
    HOUSE_NAME  VARCHAR2(20 CHAR),
    TOTAL_ROOM  NUMBER(3, 0),
    TOTAL_FLOOR NUMBER(2, 0),
    ADDRESS     VARCHAR2(100 CHAR),
    CREATED_ON  DATE,
    STATUSFLAG  NUMBER(1, 0),
    CONSTRAINT PK_HOMEDETAILS_HOUSE_ID PRIMARY KEY ( HOUSE_ID )
);

/

CREATE TABLE TBL_MST_HM_ROOMDETAILS (
    ROOM_ID     NUMBER GENERATED ALWAYS AS IDENTITY,
    OWNER_ID    NUMBER(10, 0),
    HOUSE_ID    NUMBER(10, 0),
    ROOM_NO     VARCHAR2(20 CHAR),
    FLOOR_NO    VARCHAR2(20 CHAR),
    LAST_MTR_READ   NUMBER(10,0),
    UNIT_PER_PRICE  NUMBER(3,0),
    ROOM_IMG_1  VARCHAR2(50 CHAR),
    ROOM_IMG_2  VARCHAR2(50 CHAR),
    ROOM_IMG_3  VARCHAR2(50 CHAR),
    ROOM_IMG_4  VARCHAR2(50 CHAR),
    ROOM_IMG_5  VARCHAR2(50 CHAR),
    CREATED_ON  DATE,
    STATUSFLAG  NUMBER(1, 0),
    CONSTRAINT PK_ROOMDETAILS_ROOM_ID PRIMARY KEY ( ROOM_ID )
);

/

CREATE TABLE TBL_MST_HM_TENANTDETAILS (
    TENANT_ID     NUMBER GENERATED ALWAYS AS IDENTITY,
    OWNER_ID    NUMBER(10, 0),
    HOUSE_ID    NUMBER(10, 0),
    ROOM_ID     NUMBER(10, 0),
    FULL_NAME   NUMBER(10,0),
    MOBILE_NO  NUMBER(3,0),
    ALT_MOBILE_NO  VARCHAR2(50 CHAR),
    NO_OF_MEMBER  VARCHAR2(50 CHAR),
    MEMBER_MOBILE_NO  VARCHAR2(50 CHAR),
    RENT_AMOUNT  VARCHAR2(50 CHAR),
    ADV_AMOUNT  VARCHAR2(50 CHAR),
    EFFECTIVE_DATE  VARCHAR2(50 CHAR),
    AADHAR_DETAILS  VARCHAR2(50 CHAR),
    AGGREMENT_DOC  VARCHAR2(50 CHAR),
    OTHER_DOC  VARCHAR2(50 CHAR),
    CREATED_ON  DATE,
    STATUSFLAG  NUMBER(1, 0),
    CONSTRAINT PK_TENANTDETAILS_TENANT_ID PRIMARY KEY ( TENANT_ID )
);